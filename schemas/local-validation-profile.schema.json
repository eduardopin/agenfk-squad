{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eduardopin/agenfk-squad/schemas/local-validation-profile.schema.json",
  "title": "Local validation profile v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "stack", "full_suite", "review", "budget", "steps"],
  "properties": {
    "version": {"const": 1, "type": "integer"},
    "stack": {"enum": ["backend", "web", "mobile"]},
    "full_suite": {"const": true},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["independent", "model", "max_repair_cycles", "max_calls", "max_tokens", "max_cost_usd", "timeout_seconds"],
      "properties": {
        "independent": {"const": true},
        "model": {"const": "deepseek/deepseek-v4.1-flash-1017"},
        "max_repair_cycles": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_calls": {"type": "integer", "minimum": 1, "maximum": 6},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_cost_usd": {"type": "number", "minimum": 0.001, "maximum": 10},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_seconds", "cpu_seconds", "memory_mb", "artifact_mb", "llm_calls"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 28800},
        "memory_mb": {"type": "integer", "minimum": 1, "maximum": 32768},
        "artifact_mb": {"type": "integer", "minimum": 1, "maximum": 1024},
        "llm_calls": {"type": "integer", "const": 0}
      }
    },
    "steps": {"type": "array", "minItems": 3, "maxItems": 64, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 240},
    "strings": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "argv", "cwd", "needs", "assertions", "fixtures", "services", "tools", "evidence", "rollback", "timeout_seconds", "min_tests", "outcomes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "kind": {"enum": ["static", "unit", "integration", "ui", "emulator", "recording"]},
        "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "cwd": {"$ref": "#/$defs/path"},
        "needs": {"$ref": "#/$defs/strings"},
        "assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "fixtures": {"$ref": "#/$defs/strings"},
        "services": {"$ref": "#/$defs/strings"},
        "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence": {"$ref": "#/$defs/path"},
        "rollback": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "min_tests": {"type": "integer", "minimum": 0},
        "outcomes": {"const": ["PASS", "FAIL", "BLOCKED", "TIMEOUT", "ERROR"]}
      }
    }
  }
}
